{
  "name": "lumin",
  "main": "workers/lumin.mjs",
  "compatibility_date": "2026-10-09",
  "build": { "command": "node scripts/build-web-assets.cjs" },
  "assets": {
    "directory": "./.cloudflare-assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/r2", "/r2/*", "/quotation", "/quotation/", "/quotation.html", "/quotation-logo", "/supplier-list", "/supplier-list/", "/supplier-list.html"]
  },
  "r2_buckets": [{ "binding": "LUMIN_MEDIA", "bucket_name": "lumin-clinic-media" }],
  "observability": { "enabled": false }
}
